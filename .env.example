# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Gemini (Layer 2 scoring) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Sheets (database) — path to service account JSON
GOOGLE_SHEETS_CREDENTIALS=credentials.json
GOOGLE_SHEET_ID=

# Optional fallback scoring provider
GROQ_API_KEY=
